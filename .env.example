DB_USER=postgres.<project-ref>
DB_PASSWORD=<password>
DB_HOST=aws-1-eu-west-2.pooler.supabase.com
DB_NAME=postgres
# Transaction-mode pooler - used by the running app
DB_PORT=6543
# Session-mode pooler - used by Alembic migrations
DB_MIGRATION_PORT=5432
DB_SSLMODE=require

# Shared secret the punch device must send in the X-Webhook-Secret header (empty = check disabled)
WEBHOOK_SECRET=change-me

# JWT auth - generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Timezone used to group punches into days
APP_TIMEZONE=Asia/Kolkata
